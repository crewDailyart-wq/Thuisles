# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# De databases staan NIET meer in Git (besluit van de eigenaar, 2 oktober 2026).
#
# Ze bevatten de gegevens van een kind: het profiel en de voortgang. Dat hoort
# niet in een coderepo, ook niet in een privérepo. De bestanden blijven gewoon
# op de laptop staan; ze worden alleen niet meer meegenomen. Let op: oudere
# versies staan nog wel in de Git-geschiedenis.
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm

# De bewaarde zinnen van de stem van Bliepo (Fish Audio, app/api/stem).
/data/stem/

# Back-ups die Claude maakt vóór een wijziging in de database. Niet committen:
# de volledige kopie bevat ook de kinderen en hun voortgang.
/backups

# Plugin-bestanden van de eigenaar: blijven op de laptop, niet in Git.
/artifacts

# Godot-exports: worden gemaakt met scripts/godot-export.sh (groot, ±40 MB per bouwsteen)
/public/godot/

# Uitvoer van scripts/zappie-preview-test.mjs (schermafbeeldingen, testrapport).
/preview-artifacts

# Schermfoto's van Synthesis, alleen als voorbeeld voor indeling/belichting (27 oktober 2026): NOOIT op GitHub of de website.
/INSPIRATIE-FOTO'S/

# Synthesis-analyse (Engelse tutorzinnen als bron; nooit op GitHub of de website)
/SYNTHESIS-ANALYSE/
/SCHERMEN-CONTROLE/
/TAAL-CONTROLE/
/VERGELIJKING/

# Verslagen van het maken van de stem (28 okt 2026): horen bij de laptop, niet in Git.
/data/stem-lessen*
/data/stem-ontbreekt.json
/data/controle-goed.json

# Analyse van Squla (30 okt 2026): alleen op de laptop, net als SYNTHESIS-ANALYSE.
/SQULA-ANALYSE/
/SQULA-OVERZICHT.md
/SQULA-VOORTGANG.md
