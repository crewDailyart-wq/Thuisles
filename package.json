{
  "name": "thuisles",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-zappie-illustraties.mjs && next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "schermen": "node scripts/schermcontrole.mjs",
    "bewaking": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/registreer.mjs scripts/waardebewaking.mjs",
    "bewaak": "npm run schermen && npm run bewaking && npm run oefentypes && npm run bosspellen && npm run opgaven",
    "bosspellen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/registreer.mjs scripts/bosspellen.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "oefentypes": "node scripts/oefentypes.mjs",
    "opgaven": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/registreer.mjs scripts/opgaven.mjs",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup-db.mjs",
    "maatje": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./scripts/registreer.mjs scripts/maatje-schrijf.mjs",
    "online": "node --disable-warning=ExperimentalWarning scripts/online.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lenis": "1.3.26",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
